# Dependencies
node_modules/

# Build outputs
dist/
*.tsbuildinfo

# Environment variables
# 覆盖所有 .env 变体（.env.production / .env.staging 等），仅保留样例文件
# 本项目 .env 中存放 XXL-JOB 管理员账号密码，绝不能入库
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
*.lcov
.nyc_output/

# Testing
.jest/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Misc
.cache/
.temp/
*.tmp
*.tgz

# Agent scratch / local npm cache
tmp/
.scratch/

# Agent scratch files that may land in the repo root instead of tmp/.
# (tmp/ above only matches the directory; a file named tmp-commit.txt in the
# repo root is NOT covered by it — that is how one slipped into a commit once.)
*-commit.txt
commit-msg.txt
pr-body.md
pr-*.md
