{
  "name": "@skylerfee/multi-xxl-job-mcp",
  "version": "0.1.0-beta.2",
  "description": "Multi-instance MCP Server for XXL-JOB admin: query/add/update jobs, start/stop, manual trigger and execution log viewing via XXL-JOB admin web API",
  "type": "module",
  "license": "MIT",
  "author": "SkylerFee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SkylerFee/multi-xxl-job-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/SkylerFee/multi-xxl-job-mcp/issues"
  },
  "homepage": "https://github.com/SkylerFee/multi-xxl-job-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "xxl-job",
    "scheduler",
    "task-scheduling",
    "ai",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "bin": {
    "multi-xxl-job-mcp": "dist/src/server.js"
  },
  "main": "dist/src/server.js",
  "files": [
    "dist",
    "!dist/tests"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "start": "node dist/src/server.js",
    "dev": "tsc --watch",
    "smoke": "node dist/tests/smoke.js",
    "test:integration": "node dist/tests/integration.js",
    "test:client": "node dist/tests/test-client.js",
    "prepublishOnly": "npm run build && npm run smoke",
    "test:config": "node dist/tests/config.test.js",
    "test:registry": "node dist/tests/registry.test.js",
    "test:cli": "node dist/tests/cli.test.js",
    "test:cli-add": "node dist/tests/cli-add.test.js",
    "test": "node scripts/test-all.mjs",
    "test:regression": "node dist/tests/regression.test.js",
    "test:dev": "node dist/tests/dev-scaffold.test.js",
    "release:check": "node scripts/release-policy.mjs",
    "release:dry-run": "npm pack --dry-run",
    "dev:mock": "node scripts/dev-mock.mjs",
    "dev:inspect": "node scripts/dev-inspect.mjs",
    "dev:client": "node scripts/dev-client.mjs"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.15.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.73.0"
  }
}
