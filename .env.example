# XXL-JOB 调度中心访问地址（到 admin 上下文为止，不带末尾斜杠）
# 示例: http://127.0.0.1:8080/xxl-job-admin
XXL_JOB_URL=http://127.0.0.1:8080/xxl-job-admin

# 调度中心登录账号（需要在 xxl-job 中有管理员或普通用户账号）
XXL_JOB_USERNAME=admin

# 调度中心登录密码（不要使用 123456 等默认弱口令；真实 .env 已被 gitignore 忽略）
XXL_JOB_PASSWORD=YOUR_PASSWORD_HERE

# HTTP 请求超时（毫秒），可选，默认 15000
# XXL_JOB_TIMEOUT_MS=15000
